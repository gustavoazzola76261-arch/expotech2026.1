# PostgreSQL (Supabase: use Connection string / URI from Project Settings > Database)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT — generate a long random string for production
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins). Rede local (192.168.x.x:5173) também é aceita via regex no app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ESP32 — mesma chave no config.h do firmware (header X-Device-Key)
ESP32_DEVICE_KEY=change-me-esp32-device-key

# Tarifa Enel SP (R$/kWh) — ajuste após reajuste ANEEL homologado
# ENEL_TARIFF_GROUP=B3 Convencional
# ENEL_TE_BRL_PER_KWH=0.41200
# ENEL_TUSD_BRL_PER_KWH=0.30900
# ENEL_BANDEIRA_BRL_PER_KWH=0.01874
# ENEL_ICMS_RATE=0.18
# ENEL_PIS_COFINS_RATE=0.0365

# CrewAI + Groq (módulo IA/ na raiz do projeto)
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.1-8b-instant
IA_VERBOSE=false

# Optional: bcrypt cost
# BCRYPT_ROUNDS=12
